def sortmerna_mem_mb(wildcards, input):
    size_mb = (
        os.path.getsize(input.r1) +
        os.path.getsize(input.r2)
    ) / (1024 ** 2)

    size_gb = size_mb / 1024

    if size_gb <= 10:
        return 64 * 1024
    elif size_gb <= 15:
        return 96 * 1024
    elif size_gb <= 25:
        return 128 * 1024
    elif size_gb <= 40:
        return 160 * 1024
    else:
        return 192 * 1024
    
def parse_metadata():
    """Lee metadata y extrae información de samples"""
    import sys
    
    try:
        df = pd.read_csv(METADATA_FILE, sep='\t', encoding='latin1')
    except FileNotFoundError:
        print(f"ERROR: Archivo de metadata no encontrado: {METADATA_FILE}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"ERROR: No se pudo leer el archivo de metadata: {e}", file=sys.stderr)
        sys.exit(1)
    
    # Validar columnas necesarias
    required_cols = ['external_id_sample', 'Layout', 'BioSample']
    missing_cols = [col for col in required_cols if col not in df.columns]
    if missing_cols:
        print(f"ERROR: Faltan columnas en metadata: {missing_cols}", file=sys.stderr)
        sys.exit(1)
    
    samples = []
    for idx, row in df.iterrows():
        run = str(row['external_id_sample']).strip().replace('"', '')
        layout = str(row['Layout']).strip()
        BioSample = str(row['BioSample']).strip()
        tissue_name = str(row['tissue_name']).strip()
        
        if not run or run == 'nan':
            print(f"ADVERTENCIA: Fila {idx} tiene Run vacío, saltando...", file=sys.stderr)
            continue
            
        samples.append({
            'run': run,
            'BioSample': BioSample,
            'layout': layout,
            'paired': layout == 'PAIRED',
            'tissue_name' : tissue_name
        })
    
    if not samples:
        print("ERROR: No se encontraron samples válidos en metadata", file=sys.stderr)
        sys.exit(1)
    
    return samples

def validate_references():
    """Valida que existan los archivos de referencia"""
    import sys
    missing = []
    
    refs = {
        'rRNA 18S': REF_18S,
        'rRNA 28S': REF_28S,
        'Kallisto index': KALLISTO_INDEX
    }
    
    for name, path in refs.items():
        if not os.path.exists(path):
            missing.append(f"  - {name}: {path}")
    
    if missing:
        print("ERROR: Archivos de referencia faltantes:", file=sys.stderr)
        for m in missing:
            print(m, file=sys.stderr)
        sys.exit(1)
    
    print("✓ Validación de referencias completada")


# Validar referencias antes de continuar
validate_references()

SAMPLES = parse_metadata()

ALL_RUNS = [s['run'] for s in SAMPLES]
# Biosamples - Run dictionary
BIOSAMPLE_RUNS = {}

for sample in SAMPLES:
    biosample = sample['BioSample']
    tissue = sample['tissue_name']
    run = sample['run']

    key = f"{biosample}__{tissue}"

    BIOSAMPLE_RUNS.setdefault(key, []).append(run)

ALL_BIOSAMPLES = sorted(BIOSAMPLE_RUNS.keys())
    
# Separar PAIRED y SINGLE
PAIRED_RUNS = [s['run'] for s in SAMPLES if s['paired']]

SINGLE_RUNS = [s['run'] for s in SAMPLES if not s['paired']]

# Crear sets para búsqueda rápida
PAIRED_RUNS_SET = set(PAIRED_RUNS)
SINGLE_RUNS_SET = set(SINGLE_RUNS)

print(f"Total samples: {len(ALL_RUNS)}")
print(f"  - PAIRED: {len(PAIRED_RUNS)}")
print(f"  - SINGLE: {len(SINGLE_RUNS)}")


